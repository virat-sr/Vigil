# Copy this file to .env and fill in ONE key (.env is gitignored):
#   cp .env.example .env
#
# Priority when several are set: OpenRouter > OpenAI > Gemini
# Leave all empty to use free rule-based scoring (works with the mock demo app).
# Note: keep comments on their own lines — inline comments are not supported.

# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
